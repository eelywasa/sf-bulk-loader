# Local Terraform working files
.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
plan.out

# Customer-specific configuration - never committed
backend.hcl
*.tfvars
!tiers/*.tfvars
!*.tfvars.example

# Provider lock file is intentionally NOT committed in this dual-CLI
# (Terraform + OpenTofu) configuration: each runtime records provider
# addresses against its own registry, so a lock file generated by one CLI
# conflicts under the other. Generate and commit it in your own fork/pipeline
# if you standardise on a single runtime. (Parity-deviation register, SFBL-384.)
.terraform.lock.hcl
