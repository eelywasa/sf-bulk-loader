<?xml version="1.0" encoding="UTF-8"?>
<!--
  Custom Account lookup on Contact used by the Tier 2 E2E suite (SFBL-328).

  WHY a custom lookup (rather than reusing Contact.AccountId):
    The contact-upsert-relationship spec asserts a byte-exact CSV header of
    `<lookup>__r.External_Id__c` (H1 finding in SFBL-301). The `__r` suffix
    is reserved for custom lookups — the standard Contact.Account
    relationship is named `Account` (no suffix), so referencing it as
    `Account__r.External_Id__c` returns:

      InvalidBatch : Unable to find relationship: Account__r

  WHY `ParentAccount__c` (not just `Account__c`):
    Salesforce will not let a custom field on Contact use relationshipName
    `Account` — that name is reserved by the standard AccountId lookup, and
    a deploy attempt fails locally with:

      Component conversion failed: Invalid XML tags or unable to find
      matching parent xml file for CustomField "Account__c"

    Using `ParentAccount__c` with relationshipName=`ParentAccount` keeps the
    custom `__r` suffix intact (`ParentAccount__r`) and stays clear of the
    reserved namespace.

  The field is otherwise inert: it lives only on the scratch org and is not
  wired into any business logic.
-->
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>ParentAccount__c</fullName>
    <description>Custom Account lookup used by Tier 2 E2E specs to exercise the &lt;lookup&gt;__r.External_Id__c (H1 byte-exact) relationship-header upsert path. Not used by production code.</description>
    <label>E2E Parent Account</label>
    <referenceTo>Account</referenceTo>
    <relationshipName>ParentAccount</relationshipName>
    <relationshipLabel>E2E Contacts</relationshipLabel>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Lookup</type>
    <deleteConstraint>SetNull</deleteConstraint>
</CustomField>
