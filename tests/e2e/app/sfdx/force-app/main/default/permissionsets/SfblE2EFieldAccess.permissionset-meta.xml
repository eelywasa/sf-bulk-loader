<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Field-level security grants for the custom fields the Tier 2 E2E specs upsert and query. Salesforce does NOT auto-grant FLS to metadata-API-deployed custom fields, even for System Administrator profile, so explicit permset assignment is required.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <label>SFBL E2E Field Access</label>
    <license>Salesforce</license>
    <fieldPermissions>
        <field>Account.External_Id__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>Contact.Contact_External_Id__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>SfblE2ETest__c.External_Id__c</field>
        <editable>true</editable>
        <readable>true</readable>
    </fieldPermissions>
    <objectPermissions>
        <object>SfblE2ETest__c</object>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>true</modifyAllRecords>
        <viewAllRecords>true</viewAllRecords>
    </objectPermissions>
</PermissionSet>
