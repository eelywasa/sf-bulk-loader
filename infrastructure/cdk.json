{
  "app": "npx ts-node --prefer-ts-exts bin/app.ts",
  "watch": {
    "include": ["**"],
    "exclude": ["README.md", "cdk*.json", "**/*.d.ts", "**/*.js", "tsconfig.json", "node_modules"]
  },
  "context": {
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/aws-ecs:arnFormatIncludesClusterName": true,
    "tiers": {
      "bronze": {
        "rdsInstanceClass": "db.t4g.micro",
        "rdsMultiAz": false,
        "rdsAllocatedStorage": 20,
        "rdsBackupRetentionDays": 1,
        "rdsDeletionProtection": false,
        "ecsDesiredCount": 1,
        "ecsTaskCpu": 512,
        "ecsTaskMemory": 1024,
        "logRetentionDays": 7,
        "containerInsightsEnabled": false,
        "inputRetentionDays": 7,
        "outputRetentionDays": 30,
        "workerEnabled": false,
        "redisEnabled": false,
        "wafEnabled": false,
        "useFargateSpot": false
      },
      "silver": {
        "rdsInstanceClass": "db.t4g.small",
        "rdsMultiAz": false,
        "rdsAllocatedStorage": 20,
        "rdsBackupRetentionDays": 7,
        "rdsDeletionProtection": true,
        "ecsDesiredCount": 2,
        "ecsTaskCpu": 512,
        "ecsTaskMemory": 1024,
        "logRetentionDays": 30,
        "containerInsightsEnabled": true,
        "inputRetentionDays": 30,
        "outputRetentionDays": 90,
        "workerEnabled": false,
        "redisEnabled": false,
        "wafEnabled": false,
        "useFargateSpot": false
      },
      "gold": {
        "rdsInstanceClass": "db.t4g.medium",
        "rdsMultiAz": true,
        "rdsAllocatedStorage": 100,
        "rdsBackupRetentionDays": 30,
        "rdsDeletionProtection": true,
        "ecsDesiredCount": 2,
        "ecsTaskCpu": 1024,
        "ecsTaskMemory": 2048,
        "logRetentionDays": 365,
        "containerInsightsEnabled": true,
        "inputRetentionDays": 30,
        "outputRetentionDays": 90,
        "workerEnabled": true,
        "redisEnabled": true,
        "redisInstanceClass": "cache.t4g.small",
        "redisMultiAz": true,
        "wafEnabled": true,
        "useFargateSpot": true
      }
    },
    "environments": {
      "staging": {
        "tier": "bronze",
        "vpcCidr": "10.10.0.0/16",
        "domainName": "staging.your-domain.example",
        "certificateArn": "arn:aws:acm:us-east-1:ACCOUNT:certificate/STAGING-CLOUDFRONT-CERT-ID",
        "backendDomainName": "api-staging.your-domain.example",
        "backendCertificateArn": "arn:aws:acm:REGION:ACCOUNT:certificate/STAGING-ALB-CERT-ID",
        "hostedZoneDomain": "your-domain.example",
        "ecrImageTag": "latest"
      },
      "production": {
        "tier": "silver",
        "vpcCidr": "10.20.0.0/16",
        "domainName": "bulk-loader.your-domain.example",
        "certificateArn": "arn:aws:acm:us-east-1:ACCOUNT:certificate/PROD-CLOUDFRONT-CERT-ID",
        "backendDomainName": "api.your-domain.example",
        "backendCertificateArn": "arn:aws:acm:REGION:ACCOUNT:certificate/PROD-ALB-CERT-ID",
        "hostedZoneDomain": "your-domain.example",
        "ecrImageTag": "stable"
      }
    }
  }
}
