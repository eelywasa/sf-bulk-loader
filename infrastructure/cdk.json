{
  "app": "npx ts-node --prefer-ts-exts bin/app.ts",
  "watch": {
    "include": ["**"],
    "exclude": ["README.md", "cdk*.json", "**/*.d.ts", "**/*.js", "tsconfig.json", "node_modules"]
  },
  "context": {
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/aws-ecs:arnFormatIncludesClusterName": true,
    "tiers": {
      "bronze": {
        "rdsInstanceClass": "db.t4g.micro",
        "rdsMultiAz": false,
        "rdsAllocatedStorage": 20,
        "rdsBackupRetentionDays": 1,
        "rdsDeletionProtection": false,
        "ecsDesiredCount": 1,
        "ecsTaskCpu": 512,
        "ecsTaskMemory": 1024,
        "logRetentionDays": 7,
        "containerInsightsEnabled": false,
        "inputRetentionDays": 7,
        "outputRetentionDays": 30,
        "workerEnabled": false,
        "redisEnabled": false,
        "wafEnabled": false,
        "useFargateSpot": false
      },
      "silver": {
        "rdsInstanceClass": "db.t4g.small",
        "rdsMultiAz": false,
        "rdsAllocatedStorage": 20,
        "rdsBackupRetentionDays": 7,
        "rdsDeletionProtection": true,
        "ecsDesiredCount": 2,
        "ecsTaskCpu": 512,
        "ecsTaskMemory": 1024,
        "logRetentionDays": 30,
        "containerInsightsEnabled": true,
        "inputRetentionDays": 30,
        "outputRetentionDays": 90,
        "workerEnabled": false,
        "redisEnabled": false,
        "wafEnabled": false,
        "useFargateSpot": false
      },
      "gold": {
        "rdsInstanceClass": "db.t4g.medium",
        "rdsMultiAz": true,
        "rdsAllocatedStorage": 100,
        "rdsBackupRetentionDays": 30,
        "rdsDeletionProtection": true,
        "ecsDesiredCount": 2,
        "ecsTaskCpu": 1024,
        "ecsTaskMemory": 2048,
        "logRetentionDays": 365,
        "containerInsightsEnabled": true,
        "inputRetentionDays": 30,
        "outputRetentionDays": 90,
        "workerEnabled": true,
        "redisEnabled": true,
        "redisInstanceClass": "cache.t4g.small",
        "redisMultiAz": true,
        "wafEnabled": true,
        "useFargateSpot": true
      }
    },
    "_environments_doc": "Real environment values for staging/production live in cdk.context.json (gitignored). cdk.json keeps only the tier preset assignment + ecrImageTag default; everything else (domain names, ACM cert ARNs, hosted zone, VPC CIDR, region) is operator-specific and must come from cdk.context.json. The `ci` environment is the exception — it carries safe non-routable placeholders so `cdk synth -c env=ci` works in CI without operator credentials. See docs/deployment/aws.md for the cdk.context.json shape.",
    "environments": {
      "staging": {
        "tier": "bronze",
        "ecrImageTag": "latest"
      },
      "production": {
        "tier": "silver",
        "ecrImageTag": "stable"
      },
      "ci": {
        "tier": "bronze",
        "ecrImageTag": "latest",
        "region": "eu-west-1",
        "vpcCidr": "10.0.0.0/16",
        "domainName": "ci.example.invalid",
        "certificateArn": "arn:aws:acm:us-east-1:000000000000:certificate/00000000-0000-0000-0000-000000000000",
        "backendDomainName": "api.ci.example.invalid",
        "backendCertificateArn": "arn:aws:acm:eu-west-1:000000000000:certificate/00000000-0000-0000-0000-000000000000",
        "hostedZoneDomain": "example.invalid",
        "sesIdentityDomain": "example.invalid",
        "sesIdentityAdoptExisting": false
      }
    }
  }
}
